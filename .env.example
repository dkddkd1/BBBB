# 이 파일을 .env.local 로 복사한 뒤 값을 채웁니다.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 자연어 검색·업종 필터 (Google AI Studio에서 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 아래는 내 PC 수집 워커 전용입니다. Vercel에는 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
# 공공데이터포털 > 소상공인시장진흥공단_상가(상권)정보 활용신청 후 받은 인증키 (Decoding 키 권장)
DATA_GO_KR_KEY=
# aside 명령 경로 (PATH에 있으면 비워둬도 됩니다)
ASIDE_BIN=aside
